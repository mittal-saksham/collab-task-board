# Copy this file to ".env" and adjust if you like:  cp .env.example .env
#
# These variables are read by BOTH docker-compose (to create the Postgres
# container) AND the FastAPI backend (to connect to it). One source of truth.

# --- Postgres ---
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=taskapp
POSTGRES_HOST=localhost
# Host-side port for Postgres. 5432 is the default; change it (e.g. 5434) in
# your local .env if you already have something using 5432.
POSTGRES_PORT=5432

# --- Auth / JWT ---
# Generate a strong secret for real use, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_use_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
